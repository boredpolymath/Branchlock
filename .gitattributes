# The deployable app is authored source code, not a vendored or generated artifact.
# Keep it visible to GitHub's language analyzer even though it is served from dist/.
workflow-guardian-prototype/dist/** -linguist-vendored -linguist-generated
workflow-guardian-prototype/dist/*.js linguist-detectable=true
workflow-guardian-prototype/dist/*.css linguist-detectable=true
workflow-guardian-prototype/dist/*.html linguist-detectable=true
